---
import { SUPPORTED_LANGUAGES, getLanguagePath } from '../i18n';
import type { LocalizedDictionary } from '../types/journal';

interface Props {
  currentLocale: string;
  dict: LocalizedDictionary;
}

const { currentLocale, dict } = Astro.props;
---

<footer class="mt-12 border-t border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface/60 dark:bg-editorial-darkSurface/60 py-12 px-4 sm:px-6 no-print transition-colors duration-200">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- SEO Technical Section: Features & FAQ for Organic Search Indexing -->
    <section class="border-b border-editorial-borderLight dark:border-editorial-borderDark pb-12">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="font-journal font-bold text-2xl sm:text-3xl text-editorial-ink dark:text-stone-100 tracking-tight">
          {dict.seoContent.featuresHeading}
        </h2>
        <p class="mt-2 text-sm text-editorial-mutedLight dark:text-editorial-mutedDark">
          {dict.seoContent.heroSubtitle}
        </p>
      </div>

      <!-- Features 4-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          dict.seoContent.features.map((feat) => (
            <div class="p-5 rounded-2xl bg-editorial-lightSurface dark:bg-editorial-darkSurface border border-editorial-borderLight dark:border-editorial-borderDark shadow-subtle hover:border-brand/40 transition-colors">
              <div class="w-8 h-8 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold text-sm mb-3">
                ✓
              </div>
              <h3 class="font-bold text-sm text-editorial-ink dark:text-stone-100 mb-1.5">
                {feat.title}
              </h3>
              <p class="text-xs text-editorial-mutedLight dark:text-editorial-mutedDark leading-relaxed">
                {feat.description}
              </p>
            </div>
          ))
        }
      </div>

      <!-- FAQ Section -->
      <div class="mt-12 max-w-4xl mx-auto">
        <h3 class="font-journal font-bold text-xl text-center text-editorial-ink dark:text-stone-100 mb-6">
          {dict.seoContent.faqHeading}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            dict.seoContent.faqs.map((faq) => (
              <div class="p-4 rounded-xl bg-editorial-lightSurface dark:bg-editorial-darkSurface border border-editorial-borderLight dark:border-editorial-borderDark">
                <h4 class="font-semibold text-xs sm:text-sm text-editorial-ink dark:text-stone-100 mb-1.5">
                  {faq.q}
                </h4>
                <p class="text-xs text-editorial-mutedLight dark:text-editorial-mutedDark leading-relaxed">
                  {faq.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Bottom Navigation, Language Links & Credits -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-4 text-xs text-editorial-mutedLight dark:text-editorial-mutedDark">
      
      <!-- Brand & Privacy Notice -->
      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2">
          <span class="font-journal font-bold text-base text-editorial-ink dark:text-stone-100">
            {dict.nav.brand}
          </span>
          <span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-300/50">
            Zero Server
          </span>
        </div>
        <p class="text-[11px]">
          100% Client-Side Privacy. Stored in your device's browser memory.
        </p>
      </div>

      <!-- Language Links Bar -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        {
          SUPPORTED_LANGUAGES.map((lang) => (
            <a
              href={getLanguagePath(lang.code)}
              class={`px-2 py-1 rounded-md text-[11px] font-medium transition-colors ${
                lang.code === currentLocale
                  ? 'bg-brand/10 text-brand font-bold'
                  : 'hover:text-editorial-ink dark:hover:text-stone-100'
              }`}
            >
              {lang.label}
            </a>
          ))
        }
      </div>

      <!-- Developer Support -->
      <div class="flex items-center gap-3">
        <a
          href="https://buymeacoffee.com/kisharadilz"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FCE38A] hover:bg-[#ebd279] text-stone-900 font-semibold text-xs shadow-subtle hover:scale-105 transition-all border border-[#ebd279]"
        >
          <span>☕</span>
          <span>{dict.nav.supportDev}</span>
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="text-center text-[11px] text-stone-400 dark:text-stone-600 pt-4 border-t border-editorial-borderLight/60 dark:border-editorial-borderDark/60">
      DailyDiary — Free 100% Private Zero-Server Online Journal. Open-source client-side cryptography.
    </div>

  </div>
</footer>
