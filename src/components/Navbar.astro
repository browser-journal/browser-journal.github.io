---
import { SUPPORTED_LANGUAGES, getLanguagePath } from '../i18n';
import type { LocalizedDictionary } from '../types/journal';

interface Props {
  currentLocale: string;
  dict: LocalizedDictionary;
}

const { currentLocale, dict } = Astro.props;
const currentLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === currentLocale) || SUPPORTED_LANGUAGES[0];
---

<header class="sticky top-0 z-30 w-full border-b border-editorial-borderLight/80 dark:border-editorial-borderDark/80 bg-editorial-lightBg/95 dark:bg-editorial-darkBg/95 backdrop-blur-md transition-colors duration-200 no-print">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-3">
    
    <!-- Left: Brand and Entries Drawer Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Entries Drawer Button -->
      <button
        type="button"
        id="toggle-sidebar-btn"
        class="px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-700 dark:text-stone-300 hover:border-brand hover:text-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle"
        title="Open Past Entries & Search"
        aria-label="Open Past Entries & Search"
      >
        <svg class="w-4 h-4 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <span class="hidden sm:inline font-medium">Entries</span>
      </button>

      <!-- Brand -->
      <a
        href={getLanguagePath(currentLocale)}
        class="flex items-center gap-2 text-editorial-ink dark:text-stone-100 rounded-lg p-1 transition-all"
        title="DailyDiary"
      >
        <div class="w-7 h-7 rounded-lg bg-brand text-stone-900 flex items-center justify-center shadow-subtle font-bold">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="font-journal font-bold text-base tracking-tight text-editorial-ink dark:text-stone-100">
          {dict.nav.brand}
        </span>
      </a>

      <!-- 100% Private Subtle Badge -->
      <span
        class="hidden md:inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-[#EAFFD0]/80 dark:bg-[#EAFFD0]/15 text-stone-800 dark:text-[#95E1D3] border border-[#95E1D3]/50"
        title="100% Private. Stored only in your browser."
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#95E1D3]"></span>
        <span>Local & Private</span>
      </span>
    </div>

    <!-- Right: Clean Minimal Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      
      <!-- Palette Customizer -->
      <button
        type="button"
        id="theme-customizer-btn"
        class="p-1.5 sm:px-2.5 sm:py-1 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle"
        title={dict.nav.themeCustomizer}
      >
        <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4 8.001 8.001 0 0110.87-7.426 4 4 0 016.13 3.426V15a4 4 0 01-4 4h-2.5a1.5 1.5 0 00-1.5 1.5v.5A2 2 0 017 21z" />
          <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
          <circle cx="12" cy="6" r="1.5" fill="currentColor" stroke="none" />
          <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
        </svg>
        <span class="hidden sm:inline">Theme</span>
      </button>

      <!-- PIN Security Trigger -->
      <button
        type="button"
        id="nav-pin-btn"
        class="p-1.5 sm:px-2 sm:py-1 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1 text-xs font-medium shadow-subtle"
        title="PIN Security Lock"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
        <span class="hidden sm:inline">Lock</span>
      </button>

      <!-- Backup / Export Trigger -->
      <button
        type="button"
        id="nav-export-btn"
        class="p-1.5 sm:px-2 sm:py-1 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1 text-xs font-medium shadow-subtle"
        title={dict.nav.backupRestore}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.5V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden sm:inline">Export</span>
      </button>

      <!-- Dark Mode Switcher -->
      <button
        type="button"
        id="dark-mode-toggle"
        class="p-1.5 sm:p-2 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center justify-center shadow-subtle"
        title="Toggle Light/Dark Theme"
        aria-label="Toggle Light/Dark Theme"
      >
        <svg id="sun-icon" class="hidden w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon" class="w-3.5 h-3.5 text-stone-600 dark:text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- 7-Language Dropdown -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-toggle"
          class="p-1.5 sm:px-2 sm:py-1 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-editorial-ink dark:text-stone-200 hover:border-brand transition-all flex items-center gap-1 text-xs font-medium shadow-subtle"
          aria-haspopup="true"
          aria-expanded="false"
          title="Select Language"
        >
          <span class="inline-flex items-center justify-center font-bold text-[10px] bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 px-1 py-0.5 rounded border border-stone-200 dark:border-stone-700">
            {currentLangObj.badge}
          </span>
          <svg class="w-3 h-3 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-44 rounded-xl bg-editorial-lightSurface dark:bg-editorial-darkSurface border border-editorial-borderLight dark:border-editorial-borderDark shadow-card dark:shadow-cardDark py-1 z-50 animate-in fade-in slide-in-from-top-1 duration-150"
        >
          {
            SUPPORTED_LANGUAGES.map((lang) => {
              const isCurrent = lang.code === currentLocale;
              return (
                <a
                  href={getLanguagePath(lang.code)}
                  class={`flex items-center justify-between px-3 py-1.5 text-xs transition-colors ${
                    isCurrent
                      ? 'bg-brand/10 text-brand font-semibold'
                      : 'text-editorial-ink dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800'
                  }`}
                >
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-[10px] bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 px-1.5 py-0.5 rounded border border-stone-200 dark:border-stone-700">
                      {lang.badge}
                    </span>
                    <span>{lang.label}</span>
                  </div>
                  {isCurrent && (
                    <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Buy Me a Coffee Support Link -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="p-1.5 sm:px-2.5 sm:py-1 rounded-lg bg-[#FCE38A] hover:bg-[#ebd279] text-stone-900 font-semibold text-xs transition-all shadow-subtle flex items-center gap-1 hover:scale-105 border border-[#ebd279]"
        title={dict.nav.supportDev}
      >
        <span>☕</span>
        <span class="hidden lg:inline">Support</span>
      </a>

    </div>
  </div>
</header>

<script>
  // Toggle Entries Sidebar in JournalApp
  document.getElementById('toggle-sidebar-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-sidebar'));
  });

  // Language Dropdown Logic
  const langToggle = document.getElementById('lang-dropdown-toggle');
  const langMenu = document.getElementById('lang-menu');
  const langWrapper = document.getElementById('lang-dropdown-wrapper');

  if (langToggle && langMenu) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langToggle.getAttribute('aria-expanded') === 'true';
      langToggle.setAttribute('aria-expanded', String(!isExpanded));
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (langWrapper && !langWrapper.contains(e.target as Node)) {
        langMenu.classList.add('hidden');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Dark Mode Toggle Logic
  const darkToggle = document.getElementById('dark-mode-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }
  }

  updateIcons();

  darkToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('daily_diary_dark_mode', String(isDark));
    updateIcons();
  });

  // Modals dispatch
  document.getElementById('theme-customizer-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-theme-modal'));
  });

  document.getElementById('nav-pin-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-pin-modal'));
  });

  document.getElementById('nav-export-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-export-modal'));
  });
</script>
