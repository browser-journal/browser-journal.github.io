---
import { SUPPORTED_LANGUAGES, getLanguagePath } from '../i18n';
import type { LocalizedDictionary } from '../types/journal';

interface Props {
  currentLocale: string;
  dict: LocalizedDictionary;
}

const { currentLocale, dict } = Astro.props;
const currentLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === currentLocale) || SUPPORTED_LANGUAGES[0];
---

<header class="sticky top-0 z-30 w-full border-b border-editorial-borderLight/80 dark:border-editorial-borderDark/80 bg-editorial-lightBg/95 dark:bg-editorial-darkBg/95 backdrop-blur-md transition-colors duration-200 no-print">
  <div class="max-w-5xl mx-auto px-3 sm:px-4 h-14 flex items-center justify-between gap-2 sm:gap-3">
    
    <!-- Left: Brand (and Desktop Entries Drawer Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Entries Drawer Button (Desktop Only: hidden on mobile & tab to keep strictly 1 toggle) -->
      <button
        type="button"
        id="toggle-sidebar-btn"
        class="hidden lg:flex px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-700 dark:text-stone-300 hover:border-brand hover:text-brand transition-all items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer active:scale-95"
        title="Open Past Entries & Search"
        aria-label="Open Past Entries & Search"
      >
        <svg class="w-4 h-4 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <span class="font-medium">Entries</span>
      </button>

      <!-- Brand -->
      <a
        href={getLanguagePath(currentLocale)}
        class="flex items-center gap-2 text-editorial-ink dark:text-stone-100 rounded-lg p-1 transition-all"
        title="DailyDiary"
      >
        <div class="w-7 h-7 rounded-lg bg-brand text-stone-900 flex items-center justify-center shadow-subtle font-bold shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="font-journal font-bold text-base tracking-tight text-editorial-ink dark:text-stone-100 truncate">
          {dict.nav.brand}
        </span>
      </a>

      <!-- 100% Private Subtle Badge (Desktop only) -->
      <span
        class="hidden xl:inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-[#EAFFD0]/80 dark:bg-[#EAFFD0]/15 text-stone-800 dark:text-[#95E1D3] border border-[#95E1D3]/50"
        title="100% Private. Stored only in your browser."
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#95E1D3]"></span>
        <span>Local & Private</span>
      </span>
    </div>

    <!-- Right: Desktop Controls (hidden on mobile & tablet: lg:flex) -->
    <div class="hidden lg:flex items-center gap-2">
      
      <!-- Book Cover Toggle -->
      <button
        type="button"
        id="nav-cover-btn"
        class="px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer"
        title="View / Customize Book Cover"
      >
        <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        <span>Cover</span>
      </button>

      <!-- Palette Customizer -->
      <button
        type="button"
        id="theme-customizer-btn"
        class="px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer"
        title={dict.nav.themeCustomizer}
      >
        <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4 8.001 8.001 0 0110.87-7.426 4 4 0 016.13 3.426V15a4 4 0 01-4 4h-2.5a1.5 1.5 0 00-1.5 1.5v.5A2 2 0 017 21z" />
          <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
          <circle cx="12" cy="6" r="1.5" fill="currentColor" stroke="none" />
          <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
        </svg>
        <span>Theme</span>
      </button>

      <!-- PIN Security Trigger -->
      <button
        type="button"
        id="nav-pin-btn"
        class="px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer"
        title="PIN Security Lock"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
        <span>Lock</span>
      </button>

      <!-- Backup / Export Trigger -->
      <button
        type="button"
        id="nav-export-btn"
        class="px-2.5 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer"
        title={dict.nav.backupRestore}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <span>Export</span>
      </button>

      <!-- Dark Mode Switcher -->
      <button
        type="button"
        id="dark-mode-toggle"
        class="p-2 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-600 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center justify-center shadow-subtle cursor-pointer"
        title="Toggle Light/Dark Theme"
        aria-label="Toggle Light/Dark Theme"
      >
        <svg class="sun-icon hidden w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="moon-icon w-3.5 h-3.5 text-stone-600 dark:text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- 7-Language Dropdown -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-toggle"
          class="px-2 py-1.5 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-editorial-ink dark:text-stone-200 hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium shadow-subtle cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
          title="Select Language"
        >
          <span class="inline-flex items-center justify-center font-bold text-[10px] bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 px-1 py-0.5 rounded border border-stone-200 dark:border-stone-700">
            {currentLangObj.badge}
          </span>
          <svg class="w-3 h-3 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="lang-menu"
          class="hidden absolute right-0 mt-2 w-44 rounded-xl bg-editorial-lightSurface dark:bg-editorial-darkSurface border border-editorial-borderLight dark:border-editorial-borderDark shadow-card dark:shadow-cardDark py-1 z-50 animate-in fade-in slide-in-from-top-1 duration-150"
        >
          {
            SUPPORTED_LANGUAGES.map((lang) => {
              const isCurrent = lang.code === currentLocale;
              return (
                <a
                  href={getLanguagePath(lang.code)}
                  class={`flex items-center justify-between px-3 py-1.5 text-xs transition-colors ${
                    isCurrent
                      ? 'bg-brand/10 text-brand font-semibold'
                      : 'text-editorial-ink dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800'
                  }`}
                >
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-[10px] bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 px-1.5 py-0.5 rounded border border-stone-200 dark:border-stone-700">
                      {lang.badge}
                    </span>
                    <span>{lang.label}</span>
                  </div>
                  {isCurrent && (
                    <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Ko-fi Support Link -->
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1.5 rounded-lg bg-[#FCE38A] hover:bg-[#ebd279] text-stone-900 font-semibold text-xs transition-all shadow-subtle flex items-center gap-1 hover:scale-105 border border-[#ebd279]"
        title={dict.nav.supportDev}
      >
        <span>☕</span>
        <span>Support</span>
      </a>

    </div>

    <!-- Right: Mobile & Tablet View - STRICTLY 1 SINGLE UNIFIED TOGGLE BUTTON (lg:hidden) -->
    <div class="flex lg:hidden items-center">
      
      <!-- THE SINGLE MOBILE & TABLET TOGGLE BUTTON -->
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        class="px-3 py-1.5 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface dark:bg-editorial-darkSurface text-stone-700 dark:text-stone-200 hover:border-brand hover:text-brand transition-all flex items-center gap-1.5 text-xs font-semibold shadow-subtle cursor-pointer active:scale-95"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <!-- Toggle Icon: Switches between Hamburger and Close X -->
        <div class="relative w-4 h-4 flex items-center justify-center">
          <svg id="mobile-menu-hamburger-icon" class="w-4 h-4 text-brand transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="mobile-menu-close-icon" class="hidden w-4 h-4 text-stone-600 dark:text-stone-300 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <span class="font-medium text-xs">Menu</span>
      </button>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MOBILE & TABLET TOGGLE MENU DRAWER                                        -->
  <!-- ========================================================================= -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-b border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightSurface/98 dark:bg-editorial-darkSurface/98 backdrop-blur-xl shadow-2xl transition-all duration-200 overflow-y-auto max-h-[calc(100vh-3.5rem)]"
  >
    <div class="max-w-5xl mx-auto px-4 py-3.5 space-y-3.5">
      
      <!-- Top Status & Theme Mode Switcher Line -->
      <div class="flex items-center justify-between pb-2 border-b border-editorial-borderLight dark:border-editorial-borderDark text-xs">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#95E1D3]"></span>
          <span class="font-bold text-stone-700 dark:text-stone-200">Journal Menu</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#EAFFD0]/80 dark:bg-[#EAFFD0]/15 text-stone-800 dark:text-[#95E1D3] border border-[#95E1D3]/50">
            100% Private
          </span>
        </div>

        <!-- 1-Tap Light/Dark Mode Switcher inside the Menu Drawer -->
        <button
          type="button"
          id="dark-mode-toggle-mobile"
          class="px-2.5 py-1 rounded-lg border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg dark:bg-editorial-darkBg text-stone-700 dark:text-stone-300 hover:text-brand hover:border-brand transition-all flex items-center gap-1.5 text-xs font-medium cursor-pointer active:scale-95 shadow-subtle"
          title="Toggle Light/Dark Theme"
          aria-label="Toggle Light/Dark Theme"
        >
          <svg class="sun-icon hidden w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="moon-icon w-3.5 h-3.5 text-stone-600 dark:text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span class="text-[11px] font-semibold">Mode</span>
        </button>
      </div>

      <!-- Action Grid: Touch-Friendly Feature Cards (2 cols mobile, 3-4 cols tablet) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
        
        <!-- Past Entries & Search (Prominent 1st card in menu) -->
        <button
          type="button"
          id="mobile-entries-btn"
          class="p-3 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg/60 dark:bg-editorial-darkBg/60 hover:border-brand hover:bg-brand/5 text-left transition-all flex flex-col gap-1.5 cursor-pointer active:scale-95 group"
        >
          <div class="w-8 h-8 rounded-lg bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-stone-800 dark:text-stone-100 group-hover:text-brand">Past Entries</div>
            <div class="text-[10px] text-stone-500 dark:text-stone-400">Search & Streaks</div>
          </div>
        </button>

        <!-- Book Cover Button -->
        <button
          type="button"
          id="mobile-nav-cover-btn"
          class="p-3 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg/60 dark:bg-editorial-darkBg/60 hover:border-brand hover:bg-brand/5 text-left transition-all flex flex-col gap-1.5 cursor-pointer active:scale-95 group"
        >
          <div class="w-8 h-8 rounded-lg bg-[#F38181]/20 text-[#d45d5d] flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-stone-800 dark:text-stone-100 group-hover:text-brand">Book Cover</div>
            <div class="text-[10px] text-stone-500 dark:text-stone-400">Custom art & style</div>
          </div>
        </button>

        <!-- Aesthetic Theme Customizer -->
        <button
          type="button"
          id="mobile-theme-btn"
          class="p-3 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg/60 dark:bg-editorial-darkBg/60 hover:border-brand hover:bg-brand/5 text-left transition-all flex flex-col gap-1.5 cursor-pointer active:scale-95 group"
        >
          <div class="w-8 h-8 rounded-lg bg-[#95E1D3]/30 text-teal-700 dark:text-[#95E1D3] flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4 8.001 8.001 0 0110.87-7.426 4 4 0 016.13 3.426V15a4 4 0 01-4 4h-2.5a1.5 1.5 0 00-1.5 1.5v.5A2 2 0 017 21z" />
              <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="12" cy="6" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-stone-800 dark:text-stone-100 group-hover:text-brand">Theme & Colors</div>
            <div class="text-[10px] text-stone-500 dark:text-stone-400">Pastel & fonts</div>
          </div>
        </button>

        <!-- PIN Security Lock -->
        <button
          type="button"
          id="mobile-pin-btn"
          class="p-3 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg/60 dark:bg-editorial-darkBg/60 hover:border-brand hover:bg-brand/5 text-left transition-all flex flex-col gap-1.5 cursor-pointer active:scale-95 group"
        >
          <div class="w-8 h-8 rounded-lg bg-[#FCE38A]/40 text-amber-800 dark:text-[#FCE38A] flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-stone-800 dark:text-stone-100 group-hover:text-brand">PIN Security</div>
            <div class="text-[10px] text-stone-500 dark:text-stone-400">256-bit AES Lock</div>
          </div>
        </button>

        <!-- Backup & Export -->
        <button
          type="button"
          id="mobile-export-btn"
          class="p-3 rounded-xl border border-editorial-borderLight dark:border-editorial-borderDark bg-editorial-lightBg/60 dark:bg-editorial-darkBg/60 hover:border-brand hover:bg-brand/5 text-left transition-all flex flex-col gap-1.5 cursor-pointer active:scale-95 group"
        >
          <div class="w-8 h-8 rounded-lg bg-[#EAFFD0]/70 text-emerald-800 dark:text-[#95E1D3] flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.5V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-stone-800 dark:text-stone-100 group-hover:text-brand">Export & Backup</div>
            <div class="text-[10px] text-stone-500 dark:text-stone-400">JSON, Markdown, PDF</div>
          </div>
        </button>

        <!-- Ko-fi Support -->
        <a
          href="https://ko-fi.com/kishara"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-xl border border-[#ebd279] bg-[#FCE38A]/50 hover:bg-[#FCE38A] text-left transition-all flex flex-col gap-1.5 group active:scale-95"
        >
          <div class="w-8 h-8 rounded-lg bg-[#FCE38A] text-stone-900 flex items-center justify-center font-bold text-sm shadow-subtle group-hover:scale-105 transition-transform">
            ☕
          </div>
          <div>
            <div class="text-xs font-bold text-stone-900">Support Dev</div>
            <div class="text-[10px] text-stone-700">Ko-fi</div>
          </div>
        </a>

      </div>

      <!-- Language Switcher Section with Country Badges -->
      <div class="pt-2.5 border-t border-editorial-borderLight dark:border-editorial-borderDark">
        <div class="text-[11px] font-semibold text-stone-600 dark:text-stone-300 mb-2 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <span>Language / Idioma / 言語</span>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
          {
            SUPPORTED_LANGUAGES.map((lang) => {
              const isCurrent = lang.code === currentLocale;
              return (
                <a
                  href={getLanguagePath(lang.code)}
                  class={`px-2.5 py-1.5 rounded-lg text-xs font-medium flex items-center justify-between transition-all ${
                    isCurrent
                      ? 'bg-brand text-stone-900 font-bold shadow-subtle ring-1 ring-stone-900/10'
                      : 'bg-editorial-lightBg dark:bg-editorial-darkBg text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-800 border border-editorial-borderLight dark:border-editorial-borderDark'
                  }`}
                >
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="text-[10px] font-mono font-bold bg-white/60 dark:bg-black/30 px-1 py-0.2 rounded">
                      {lang.badge}
                    </span>
                    <span class="truncate">{lang.label}</span>
                  </div>
                  {isCurrent && (
                    <svg class="w-3.5 h-3.5 text-stone-900 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </a>
              );
            })
          }
        </div>
      </div>

    </div>
  </div>
</header>

<script>
  // --------------------------------------------------------------------------
  // Mobile & Tablet Single Menu Toggle
  // --------------------------------------------------------------------------
  const mobileMenuBtn = document.getElementById('mobile-menu-toggle-btn');
  const mobileNavMenu = document.getElementById('mobile-nav-menu');
  const hamburgerIcon = document.getElementById('mobile-menu-hamburger-icon');
  const closeIcon = document.getElementById('mobile-menu-close-icon');

  function setMobileMenuOpen(open: boolean) {
    if (!mobileNavMenu || !mobileMenuBtn) return;
    if (open) {
      mobileNavMenu.classList.remove('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileNavMenu.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  mobileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = mobileNavMenu?.classList.contains('hidden') === false;
    setMobileMenuOpen(!isOpen);
  });

  // Close mobile menu on clicking outside
  document.addEventListener('click', (e) => {
    if (mobileNavMenu && !mobileNavMenu.contains(e.target as Node) && !mobileMenuBtn?.contains(e.target as Node)) {
      setMobileMenuOpen(false);
    }
  });

  // Close mobile menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setMobileMenuOpen(false);
    }
  });

  // Close mobile menu on resizing to desktop (>= 1024px)
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      setMobileMenuOpen(false);
    }
  });

  // --------------------------------------------------------------------------
  // Action Event Dispatchers (Desktop & Mobile)
  // --------------------------------------------------------------------------
  // Toggle Entries Sidebar
  const triggerEntries = () => {
    window.dispatchEvent(new CustomEvent('toggle-sidebar'));
    setMobileMenuOpen(false);
  };
  document.getElementById('toggle-sidebar-btn')?.addEventListener('click', triggerEntries);
  document.getElementById('mobile-entries-btn')?.addEventListener('click', triggerEntries);

  // Book Cover
  const triggerCover = () => {
    window.dispatchEvent(new CustomEvent('toggle-book-cover'));
    setMobileMenuOpen(false);
  };
  document.getElementById('nav-cover-btn')?.addEventListener('click', triggerCover);
  document.getElementById('mobile-nav-cover-btn')?.addEventListener('click', triggerCover);

  // Theme Customizer Modal
  const triggerTheme = () => {
    window.dispatchEvent(new CustomEvent('open-theme-modal'));
    setMobileMenuOpen(false);
  };
  document.getElementById('theme-customizer-btn')?.addEventListener('click', triggerTheme);
  document.getElementById('mobile-theme-btn')?.addEventListener('click', triggerTheme);

  // PIN Security Modal
  const triggerPin = () => {
    window.dispatchEvent(new CustomEvent('open-pin-modal'));
    setMobileMenuOpen(false);
  };
  document.getElementById('nav-pin-btn')?.addEventListener('click', triggerPin);
  document.getElementById('mobile-pin-btn')?.addEventListener('click', triggerPin);

  // Export / Backup Modal
  const triggerExport = () => {
    window.dispatchEvent(new CustomEvent('open-export-modal'));
    setMobileMenuOpen(false);
  };
  document.getElementById('nav-export-btn')?.addEventListener('click', triggerExport);
  document.getElementById('mobile-export-btn')?.addEventListener('click', triggerExport);

  // --------------------------------------------------------------------------
  // Desktop Language Dropdown Logic
  // --------------------------------------------------------------------------
  const langToggle = document.getElementById('lang-dropdown-toggle');
  const langMenu = document.getElementById('lang-menu');
  const langWrapper = document.getElementById('lang-dropdown-wrapper');

  if (langToggle && langMenu) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = langToggle.getAttribute('aria-expanded') === 'true';
      langToggle.setAttribute('aria-expanded', String(!isExpanded));
      langMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (langWrapper && !langWrapper.contains(e.target as Node)) {
        langMenu.classList.add('hidden');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // --------------------------------------------------------------------------
  // Dark Mode Toggle Logic (Desktop & Mobile Drawer)
  // --------------------------------------------------------------------------
  const darkToggleDesktop = document.getElementById('dark-mode-toggle');
  const darkToggleMobile = document.getElementById('dark-mode-toggle-mobile');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.sun-icon').forEach((el) => {
      if (isDark) el.classList.remove('hidden');
      else el.classList.add('hidden');
    });
    document.querySelectorAll('.moon-icon').forEach((el) => {
      if (isDark) el.classList.add('hidden');
      else el.classList.remove('hidden');
    });
  }

  updateIcons();

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('daily_diary_dark_mode', String(isDark));
    updateIcons();
  }

  darkToggleDesktop?.addEventListener('click', toggleTheme);
  darkToggleMobile?.addEventListener('click', toggleTheme);
</script>
